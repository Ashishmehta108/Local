{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileFinder",
  "version": "0.1.0",
  "identifier": "local.filefinder.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "FileFinder", "width": 1180, "height": 760, "minWidth": 760, "minHeight": 560, "center": true }],
    "security": { "csp": "default-src 'self'; connect-src 'self' https: wss: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self'" }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/filefinder-agent"],
    "targets": ["nsis", "msi"],
    "windows": { "wix": { "language": "en-US" }, "nsis": { "installMode": "perMachine" } }
  }
}
