NODE_ENV=development
HOST=127.0.0.1
PORT=7443
TRUST_PROXY=false
DATABASE_URL=postgres://filefinder:filefinder@127.0.0.1:5432/filefinder
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=10000
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
BOOTSTRAP_TOKEN=replace-this-with-a-one-time-install-token
COMMAND_SIGNING_PRIVATE_KEY=base64-pkcs8-ed25519-private-key-generated-by-pnpm-generate-signing-key
UI_ORIGINS=https://tauri.localhost,tauri://localhost,http://localhost:1420,http://127.0.0.1:1420
REQUIRE_AGENT_SIGNATURES=true
REQUIRE_AGENT_CERTIFICATE=true
